# Crowdtone — copy to .env.local and fill in your keys.
# The app also runs with NO keys at all using bundled demo data ("Try demo").

# YouTube Data API v3 key (Google Cloud console -> enable "YouTube Data API v3").
# Reads public data: videos.list, commentThreads.list, channels.list, playlistItems.list.
YOUTUBE_API_KEY=

# LLM for clustering + briefs. Provide ONE of the following:
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: override the model (defaults: openai/gpt-4o-mini on OpenRouter, gpt-4o-mini on OpenAI)
LLM_MODEL=

# ---- Optional: connecting a channel, which is what lets the app WRITE ----
# Without these the app is read-only: it drafts and previews changes but cannot
# publish them. With them, a creator can sign in and let Crowdtone update
# titles, descriptions and chapters, upload thumbnails, publish localized
# metadata, post comments and replies, and moderate scam/spam comments on their
# own channel's videos. Also enable the "YouTube Analytics API" in the same
# Cloud project to get retention curves, traffic sources, and geography.
#
# Google Cloud console -> APIs & Services -> Credentials -> Create OAuth client ID
# -> Web application. Add a redirect URI per origin you run on:
#   http://localhost:3000/api/auth/callback
#   https://<your-deployment>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only needed when the app sits behind a proxy that rewrites the host;
# otherwise the redirect URI is derived from the request origin.
OAUTH_REDIRECT_URI=

# Optional: signs the session cookie. Defaults to GOOGLE_CLIENT_SECRET.
# Any long random string; changing it signs everyone out.
SESSION_SECRET=

# Optional: how many comments a single video analysis reads. commentThreads.list
# costs 1 quota unit per 100 comments, so the default 1000 is 10 of the free
# 10,000 units a day. Raising it costs quota and request time, nothing else.
MAX_COMMENTS=

# Optional: clustering is the one step whose cost scales with the comment count,
# so it runs in batches. Defaults: 150 comments per model call, at most 6 calls
# (900 comments), 4 in flight, 60s each. Anything past the cap is classified by
# the keyword scan instead, and the report says which tier covered what.
LLM_BATCH_SIZE=
LLM_MAX_BATCHES=
LLM_BATCH_CONCURRENCY=
LLM_BATCH_TIMEOUT_MS=
